# Copy to .env and fill in from https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a Redirect URL registered on your WHOOP app
WHOOP_REDIRECT_URI=http://localhost:8000/callback

# Optional
# WHOOP_DASHBOARD_PORT=8000
# WHOOP_MCP_HOME=~/.whoop-mcp     # where tokens + insights are stored
# WHOOP_MCP_DEMO=1                # serve synthetic data (no WHOOP account needed)
